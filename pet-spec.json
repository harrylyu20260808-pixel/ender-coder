{
  "schemaVersion": 5,
  "app": {
    "name": "Ender Coder",
    "appId": "com.endercoder.pet",
    "version": "1.0.0",
    "language": "zh-CN"
  },
  "targets": {
    "windows": { "enabled": true, "arch": "x64" },
    "macos": { "enabled": false, "arch": "current" }
  },
  "character": {
    "inputType": "single-image",
    "coreAsset": "core-ip/core-ip.png",
    "displayName": "Ender Coder",
    "archetype": "fantasy",
    "personality": ["专注", "geek", "佛系", "debug时抓狂"],
    "preserveTraits": ["黑色方块头", "玫粉色方形眼睛", "玫粉色领带", "黑色长方形身体", "两条细长黑腿", "方块手臂"],
    "style": "balanced-cartoon",
    "mirrorSafe": false
  },
  "assetPipeline": {
    "backgroundMode": "semantic-cutout",
    "segmentationBackend": "auto",
    "subjectKind": "illustration",
    "generationBackground": "transparent-grid",
    "backgroundTolerance": 28,
    "edgeFeather": 12,
    "safeMargin": 24,
    "targetOccupancy": 0.78
  },
  "experience": {
    "theme": {
      "primary": "#F2569A",
      "accent": "#FFC2DD",
      "background": "#FFF5FA",
      "surface": "#FFFFFF",
      "text": "#221A1F",
      "muted": "#A98898",
      "cornerRadius": 22
    },
    "petSizing": {
      "baseWindowPx": 220,
      "defaultScale": 0.8
    },
    "interactions": [
      {
        "id": "write-code",
        "emoji": "💻",
        "label": "敲代码",
        "stateId": "code",
        "durationMs": 2000,
        "affectionGain": 3,
        "feedback": ["沙沙沙，代码又增加了", "这段我一次跑通！", "编译通过，舒服了"]
      },
      {
        "id": "feed-coffee",
        "emoji": "☕",
        "label": "喂咖啡",
        "stateId": "coffee",
        "durationMs": 1900,
        "affectionGain": 5,
        "feedback": ["吨吨吨，bug都吓跑了", "续命成功！", "这杯我干了"]
      },
      {
        "id": "catch-bug",
        "emoji": "🐛",
        "label": "抓Bug",
        "stateId": "bug",
        "durationMs": 2000,
        "affectionGain": 4,
        "feedback": ["抓到你了，小bug！", "休想逃出我的终端", "又消灭一个"]
      },
      {
        "id": "pet-head",
        "emoji": "🖤",
        "label": "摸摸头",
        "stateId": "pet",
        "durationMs": 1600,
        "affectionGain": 3,
        "feedback": ["嗯……再摸一下嘛", "方块头也很好摸吧", "陪我再写会儿代码"]
      }
    ]
  },
  "motion": {
    "breathing": { "enabled": true, "periodMs": 3200, "scaleX": 0.012, "scaleY": 0.022 },
    "squashStretch": { "enabled": true, "durationMs": 320, "intensity": 0.08 },
    "idleIntervalMs": { "min": 7000, "max": 13000 }
  },
  "features": {
    "transparentWindow": true,
    "drag": true,
    "tray": true,
    "edgeSnap": true,
    "reminders": true,
    "interactions": true,
    "relationship": true,
    "filePocket": false,
    "dashboard": true,
    "typingReaction": false,
    "autonomousMovement": false
  },
  "states": [
    {
      "id": "idle",
      "triggers": ["app:start", "ambient:idle"],
      "frames": ["idle-01.png", "idle-02.png", "idle-03.png", "idle-04.png"],
      "frameDurationMs": 900,
      "loop": true,
      "priority": 10,
      "interrupt": "resume",
      "cooldownMs": 0,
      "direction": "neutral",
      "anchor": { "x": 0.5, "y": 0.95 },
      "mirrorSafe": false
    },
    {
      "id": "blink",
      "triggers": ["ambient:blink"],
      "frames": ["blink-01.png", "blink-02.png", "blink-03.png", "blink-04.png", "blink-05.png"],
      "frameDurationMs": 75,
      "loop": false,
      "priority": 30,
      "interrupt": "restart",
      "cooldownMs": 2500,
      "direction": "neutral",
      "anchor": { "x": 0.5, "y": 0.95 },
      "mirrorSafe": true
    },
    {
      "id": "happy",
      "triggers": ["pointer:tap"],
      "frames": ["happy-01.png", "happy-02.png", "happy-03.png", "happy-04.png", "happy-05.png"],
      "frameDurationMs": 110,
      "loop": false,
      "priority": 70,
      "interrupt": "restart",
      "cooldownMs": 300,
      "direction": "neutral",
      "anchor": { "x": 0.5, "y": 0.95 },
      "mirrorSafe": true
    },
    {
      "id": "notify",
      "triggers": ["reminder:due"],
      "frames": ["notify-01.png", "notify-02.png", "notify-03.png", "notify-04.png", "notify-05.png"],
      "frameDurationMs": 120,
      "loop": false,
      "priority": 95,
      "interrupt": "restart",
      "cooldownMs": 800,
      "direction": "neutral",
      "anchor": { "x": 0.5, "y": 0.95 },
      "mirrorSafe": true
    },
    {
      "id": "peek",
      "triggers": ["window:edge-snap"],
      "frames": ["peek-01.png", "peek-02.png", "peek-03.png", "peek-04.png", "peek-05.png"],
      "frameDurationMs": 120,
      "loop": false,
      "priority": 55,
      "interrupt": "resume",
      "cooldownMs": 1800,
      "direction": "neutral",
      "anchor": { "x": 0.5, "y": 0.95 },
      "mirrorSafe": false
    },
    {
      "id": "code",
      "triggers": ["interaction:write-code"],
      "frames": ["code-01.png", "code-02.png", "code-03.png", "code-04.png", "code-05.png", "code-06.png"],
      "frameDurationMs": 120,
      "loop": true,
      "priority": 85,
      "interrupt": "restart",
      "cooldownMs": 300,
      "direction": "neutral",
      "anchor": { "x": 0.5, "y": 0.95 },
      "mirrorSafe": false
    },
    {
      "id": "coffee",
      "triggers": ["interaction:feed-coffee"],
      "frames": ["coffee-01.png", "coffee-02.png", "coffee-03.png", "coffee-04.png", "coffee-05.png", "coffee-06.png"],
      "frameDurationMs": 120,
      "loop": true,
      "priority": 85,
      "interrupt": "restart",
      "cooldownMs": 300,
      "direction": "neutral",
      "anchor": { "x": 0.5, "y": 0.95 },
      "mirrorSafe": false
    },
    {
      "id": "bug",
      "triggers": ["interaction:catch-bug"],
      "frames": ["bug-01.png", "bug-02.png", "bug-03.png", "bug-04.png", "bug-05.png", "bug-06.png"],
      "frameDurationMs": 120,
      "loop": true,
      "priority": 85,
      "interrupt": "restart",
      "cooldownMs": 300,
      "direction": "neutral",
      "anchor": { "x": 0.5, "y": 0.95 },
      "mirrorSafe": false
    },
    {
      "id": "pet",
      "triggers": ["interaction:pet-head"],
      "frames": ["pet-01.png", "pet-02.png", "pet-03.png", "pet-04.png", "pet-05.png"],
      "frameDurationMs": 120,
      "loop": true,
      "priority": 85,
      "interrupt": "restart",
      "cooldownMs": 250,
      "direction": "neutral",
      "anchor": { "x": 0.5, "y": 0.95 },
      "mirrorSafe": true
    }
  ],
  "storage": {
    "userData": "app-user-data",
    "filePocket": "documents-app-name"
  },
  "build": {
    "windows": { "arch": "x64", "installer": "squirrel", "portable": "zip" },
    "macos": { "arch": "current", "diskImage": "dmg", "portable": "zip" },
    "timeoutMinutes": 20,
    "unsigned": true
  }
}
